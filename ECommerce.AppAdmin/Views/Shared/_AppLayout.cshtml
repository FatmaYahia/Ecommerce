<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Store Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    ...
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
  :root{
    --ink:#151417;
    --ink-soft:#5c5a63;
    --ink-faint:#9997a1;
    --paper:#f5f3f0;
    --surface:#ffffff;
    --line:#e7e4de;
    --navy:#1c2340;
    --navy-soft:#2c3358;
    --amber:#e8a13d;
    --amber-ink:#6b4a0f;
    --amber-bg:#fbf0dd;
    --mint:#3f8f6f;
    --mint-bg:#e6f3ec;
    --coral:#d8624a;
    --coral-bg:#fbeae5;
    --radius:10px;
    --font-display: 'Space Grotesk', sans-serif;
    --font-body: 'Inter', sans-serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    font-family: var(--font-body);
    background: var(--paper);
    color: var(--ink);
    display:flex;
    min-height:100vh;
    font-size:14px;
  }

  /* ---------- Sidebar ---------- */
  .sidebar{
    width:230px;
    background: var(--navy);
    color: #e9e8f2;
    flex-shrink:0;
    display:flex;
    flex-direction:column;
    padding: 24px 16px;
    position:sticky;
    top:0;
    height:100vh;
  }
  .brand{
    font-family: var(--font-display);
    font-weight:700;
    font-size:20px;
    letter-spacing:-0.02em;
    display:flex;
    align-items:center;
    gap:8px;
    padding: 4px 8px 28px;
    color:#fff;
  }
  .brand-mark{
    width:22px; height:22px;
    border-radius:6px;
    background: var(--amber);
    display:inline-block;
  }
  .nav-group-label{
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:#8b8ea8;
    padding: 16px 12px 6px;
  }
  .nav-item{
    display:flex;
    align-items:center;
    gap:10px;
    padding:9px 12px;
    border-radius:8px;
    color:#c7c6dd;
    text-decoration:none;
    font-size:13.5px;
    font-weight:500;
    cursor:pointer;
    transition: background .12s ease, color .12s ease;
  }
  .nav-item:hover{ background: rgba(255,255,255,0.06); color:#fff; }
  .nav-item.active{ background: var(--navy-soft); color:#fff; }
  .nav-item.active::before{
    content:"";
    width:3px; height:16px;
    background: var(--amber);
    border-radius:2px;
    margin-left:-15px;
    margin-right:12px;
  }
  .nav-icon{ font-size:15px; width:18px; text-align:center; }
  .sidebar-footer{
    margin-top:auto;
    padding: 14px 12px;
    border-top: 1px solid rgba(255,255,255,0.08);
    display:flex; align-items:center; gap:10px;
  }
  .avatar{
    width:32px; height:32px; border-radius:50%;
    background: var(--amber);
    color:#5a3d0f;
    display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:12px;
    font-family: var(--font-display);
  }
  .sidebar-footer .who{ line-height:1.3; }
  .sidebar-footer .who .name{ font-size:13px; font-weight:600; color:#fff; }
  .sidebar-footer .who .role{ font-size:11.5px; color:#9391ab; }

  /* ---------- Main ---------- */
  main{ flex:1; padding: 26px 34px 60px; min-width:0; }

  .topbar{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom: 26px;
    gap:16px; flex-wrap:wrap;
  }
  .topbar h1{
    font-family: var(--font-display);
    font-size: 24px;
    font-weight:700;
    letter-spacing:-0.02em;
  }
  .topbar .sub{ color:var(--ink-soft); font-size:13px; margin-top:2px; }
  .topbar-actions{ display:flex; gap:10px; align-items:center; }
  .search{
    display:flex; align-items:center; gap:8px;
    background: var(--surface);
    border:1px solid var(--line);
    border-radius: 8px;
    padding: 8px 12px;
    font-size:13px;
    color: var(--ink-faint);
    width:220px;
  }
  .search input{ border:none; outline:none; background:none; width:100%; font-size:13px; font-family:var(--font-body); color:var(--ink);}
  .btn{
    font-family: var(--font-body);
    font-weight:600;
    font-size:13px;
    padding: 9px 16px;
    border-radius:8px;
    border:1px solid var(--line);
    background: var(--surface);
    cursor:pointer;
    display:flex; align-items:center; gap:6px;
    color:var(--ink);
    transition: transform .08s ease, background .12s ease;
  }
  .btn:active{ transform: scale(0.97); }
  .btn.primary{
    background: var(--navy);
    color:#fff;
    border-color: var(--navy);
  }
  .btn.primary:hover{ background: var(--navy-soft); }

  /* ---------- Metric cards ---------- */
  .metrics{
    display:grid;
    grid-template-columns: repeat(4, 1fr);
    gap:16px;
    margin-bottom: 24px;
  }
  .metric-card{
    background: var(--surface);
    border:1px solid var(--line);
    border-radius: var(--radius);
    padding: 18px 20px;
    position:relative;
    overflow:hidden;
  }
  .metric-card .label{
    font-size:12.5px;
    color:var(--ink-soft);
    font-weight:500;
    display:flex; align-items:center; gap:6px;
    margin-bottom:10px;
  }
  .metric-card .value{
    font-family: var(--font-display);
    font-size: 26px;
    font-weight:700;
    letter-spacing:-0.01em;
  }
  .metric-card .delta{
    font-size:12px;
    font-weight:600;
    margin-top:8px;
    display:inline-flex;
    align-items:center;
    gap:3px;
    padding:2px 8px;
    border-radius:20px;
  }
  .delta.up{ color: var(--mint); background: var(--mint-bg); }
  .delta.down{ color: var(--coral); background: var(--coral-bg); }

  /* ---------- Content grid ---------- */
  .content-grid{
    display:grid;
    grid-template-columns: 1.6fr 1fr;
    gap:20px;
    margin-bottom: 24px;
    align-items:start;
  }
  .panel{
    background: var(--surface);
    border:1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .panel-head{
    display:flex; align-items:center; justify-content:space-between;
    margin-bottom:16px;
  }
  .panel-head h2{
    font-family: var(--font-display);
    font-size:16px;
    font-weight:600;
  }
  .legend{ display:flex; gap:14px; font-size:12px; color:var(--ink-soft); }
  .legend span{ display:flex; align-items:center; gap:5px; }
  .dot{ width:8px; height:8px; border-radius:2px; display:inline-block; }
  .chart-wrap{ position:relative; height:230px; }

  .tab-row{ display:flex; gap:6px; margin-bottom:4px; }
  .tab{
    font-size:12px; font-weight:600; padding:6px 12px; border-radius:7px;
    color: var(--ink-soft); cursor:pointer;
  }
  .tab.active{ background: var(--paper); color: var(--ink); }

  /* top products list */
  .product-row{
    display:flex; align-items:center; gap:12px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .product-row:last-child{ border-bottom:none; padding-bottom:0; }
  .product-thumb{
    width:38px; height:38px; border-radius:8px;
    background: var(--paper);
    display:flex; align-items:center; justify-content:center;
    font-size:16px; flex-shrink:0;
  }
  .product-info{ flex:1; min-width:0; }
  .product-info .pname{ font-size:13px; font-weight:600; }
  .product-info .pcat{ font-size:11.5px; color:var(--ink-faint); }
  .product-stat{ text-align:right; }
  .product-stat .units{ font-size:13px; font-weight:600; }
  .product-stat .rev{ font-size:11.5px; color:var(--ink-soft); }

  /* ---------- Orders table ---------- */
  .table-panel{ background:var(--surface); border:1px solid var(--line); border-radius: var(--radius); overflow:hidden; }
  .table-panel .panel-head{ padding: 20px 22px 0; margin-bottom:14px; }
  table{ width:100%; border-collapse:collapse; }
  thead th{
    text-align:left;
    font-size:11.5px;
    text-transform:uppercase;
    letter-spacing:0.04em;
    color: var(--ink-faint);
    font-weight:600;
    padding: 10px 22px;
    border-top:1px solid var(--line);
    border-bottom:1px solid var(--line);
    background: #fbfaf8;
  }
  tbody td{
    padding: 13px 22px;
    border-bottom:1px solid var(--line);
    font-size:13px;
  }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr{ transition: background .1s ease; }
  tbody tr:hover{ background: #fbfaf8; }
  .order-id{ font-weight:600; color:var(--navy); }
  .cust{ display:flex; align-items:center; gap:9px; }
  .cust .mini-avatar{
    width:26px; height:26px; border-radius:50%;
    background: var(--paper); color:var(--ink-soft);
    display:flex; align-items:center; justify-content:center;
    font-size:10.5px; font-weight:700;
  }
  .status-pill{
    font-size:11.5px; font-weight:600;
    padding: 4px 10px; border-radius:20px;
    display:inline-block;
  }
  .status-pill.delivered{ background: var(--mint-bg); color: var(--mint); }
  .status-pill.shipped{ background:#e6eef8; color:#2f5fa8; }
  .status-pill.processing{ background: var(--amber-bg); color: var(--amber-ink); }
  .status-pill.cancelled{ background: var(--coral-bg); color: var(--coral); }
  .amount{ text-align:right; font-weight:600; }
  .row-actions{ text-align:right; color: var(--ink-faint); cursor:pointer; font-size:16px; }

  a:focus-visible, .btn:focus-visible, .nav-item:focus-visible{
    outline: 2px solid var(--amber);
    outline-offset:2px;
  }
</style>
</head>
<body>

<aside class="sidebar">
  <div class="brand"><span class="brand-mark"></span>Orbit</div>

  <div class="nav-group-label">Overview</div>
  <a class="nav-item active"><span class="nav-icon">◆</span>Dashboard</a>
  <a class="nav-item"><span class="nav-icon">▤</span>Analytics</a>

  <div class="nav-group-label">Store</div>
  <a class="nav-item"><span class="nav-icon">▢</span>Products</a>
  <a class="nav-item"><span class="nav-icon">▣</span>Orders</a>
  <a class="nav-item"><span class="nav-icon">◐</span>Customers</a>
  <a class="nav-item"><span class="nav-icon">◈</span>Marketing</a>

  <div class="nav-group-label">System</div>
  <a class="nav-item" asp-controller="Roles" asp-action="Index" ><span class="nav-icon">⚙</span>Roles</a>

  <div class="sidebar-footer">
    <div class="avatar">MR</div>
    <div class="who">
      <div class="name">Maya Rodriguez</div>
      <div class="role">Store admin</div>
    </div>
  </div>
</aside>

<main>
  <div class="topbar">
    <div>
      <h1>Good morning, @User.Identity.Name</h1>
      <div class="sub">Here's how the store is doing today, @DateTime.Today</div>
    </div>
   
  </div>
 
      @RenderBody()


</main>
<script>
        document.getElementById('addItemForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);
            const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/Items/Create', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });
            if (response.ok) {
                const result = await response.json();

                // Add new row to table
                const table = document.getElementById('itemsTable').querySelector('tbody');
                const row = table.insertRow();
                row.insertCell(0).textContent = result.item.name;
                row.insertCell(1).textContent = result.item.price;

                // Close modal + reset form
                bootstrap.Modal.getInstance(document.getElementById('addItemModal')).hide();
                form.reset();
            } else {
                alert('Failed to save item. Check the form.');
            }
</script>
<script>
const metrics = [
  { label:'Revenue', icon:'$', value:'$48,230', delta:'+12.4%', up:true },
  { label:'Orders', icon:'▣', value:'1,204', delta:'+5.1%', up:true },
  { label:'Customers', icon:'◐', value:'832', delta:'-1.2%', up:false },
  { label:'Conversion', icon:'▲', value:'3.8%', delta:'+0.4pp', up:true },
];
document.getElementById('metrics').innerHTML = metrics.map(m => `
  <div class="metric-card">
    <div class="label"><span>${m.icon}</span>${m.label}</div>
    <div class="value">${m.value}</div>
    <span class="delta ${m.up ? 'up' : 'down'}">${m.up ? '↑' : '↓'} ${m.delta}</span>
  </div>
`).join('');

const products = [
  { name:'Ridgeline backpack', cat:'Bags', icon:'🎒', units:412, rev:'$14,832' },
  { name:'Aero running shoes', cat:'Footwear', icon:'👟', units:365, rev:'$21,940' },
  { name:'Coldbrew tumbler', cat:'Home', icon:'☕', units:298, rev:'$5,662' },
  { name:'Trail rain shell', cat:'Outerwear', icon:'🧥', units:201, rev:'$12,864' },
];
document.getElementById('topProducts').innerHTML = products.map(p => `
  <div class="product-row">
    <div class="product-thumb">${p.icon}</div>
    <div class="product-info">
      <div class="pname">${p.name}</div>
      <div class="pcat">${p.cat}</div>
    </div>
    <div class="product-stat">
      <div class="units">${p.units} sold</div>
      <div class="rev">${p.rev}</div>
    </div>
  </div>
`).join('');

const orders = [
  { id:'#10482', name:'Maya Rodriguez', init:'MR', date:'Aug 20', status:'delivered', total:'$128.00' },
  { id:'#10483', name:'James Carter', init:'JC', date:'Aug 20', status:'shipped', total:'$76.50' },
  { id:'#10484', name:'Lina Chen', init:'LC', date:'Aug 19', status:'processing', total:'$249.99' },
  { id:'#10485', name:'Omar Haddad', init:'OH', date:'Aug 19', status:'cancelled', total:'$54.20' },
  { id:'#10486', name:'Priya Nair', init:'PN', date:'Aug 18', status:'delivered', total:'$310.75' },
];
document.getElementById('ordersBody').innerHTML = orders.map(o => `
  <tr>
    <td class="order-id">${o.id}</td>
    <td><div class="cust"><span class="mini-avatar">${o.init}</span>${o.name}</div></td>
    <td>${o.date}</td>
    <td><span class="status-pill ${o.status}">${o.status[0].toUpperCase() + o.status.slice(1)}</span></td>
    <td class="amount">${o.total}</td>
    <td class="row-actions">⋯</td>
  </tr>
`).join('');

new Chart(document.getElementById('salesChart'), {
  type: 'line',
  data: {
    labels: ['1','5','10','15','20','25','30'],
    datasets: [
      { label:'This period', data:[3200,4100,3800,5200,6100,5800,7200], borderColor:'#1c2340', backgroundColor:'rgba(28,35,64,0.06)', fill:true, tension:0.35, pointRadius:0, borderWidth:2.5 },
      { label:'Previous period', data:[2800,3400,3600,4200,4800,4600,5300], borderColor:'#e8a13d', backgroundColor:'transparent', borderDash:[4,3], tension:0.35, pointRadius:0, borderWidth:2 }
    ]
  },
  options: {
    responsive:true, maintainAspectRatio:false,
    plugins:{ legend:{ display:false }, tooltip:{ mode:'index', intersect:false } },
    scales:{
      y:{ ticks:{ callback:v=>'$'+(v/1000)+'k', color:'#9997a1', font:{size:11} }, grid:{ color:'#e7e4de' }, border:{display:false} },
      x:{ ticks:{ color:'#9997a1', font:{size:11} }, grid:{ display:false }, border:{display:false} }
    }
  }
});
</script>

    @RenderSection("Scripts", required: false)
</body>
</html>
